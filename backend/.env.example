# ---------------------------------------------------------------------------
#  MovieShow backend - copy to backend/.env and adjust
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Comma separated origins, or * for "any" (dev default)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Admin account used by POST /api/auth/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@movieshow.app

# Change this in production - it signs the admin session tokens
AUTH_SECRET=dev-only-secret-change-me
AUTH_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
#  EXTERNAL MOVIE API  <- the API you will share goes here
# ---------------------------------------------------------------------------
# Base URL of your API (the default below is the TMDB dialect)
MOVIE_API_BASE_URL=https://api.themoviedb.org/3
# Your key/token. Leave empty and the app simply runs on the local catalogue.
MOVIE_API_KEY=093c1c93653f65e90ccc5796f07ec53d
# query | bearer | header
MOVIE_API_AUTH_MODE=query
# Name of the query/header parameter that carries the key
MOVIE_API_KEY_PARAM=api_key
# Where poster/backdrop paths are rooted
MOVIE_API_IMAGE_BASE=https://image.tmdb.org/t/p
MOVIE_API_LANGUAGE=en-US
MOVIE_API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
#  Trending maths
# ---------------------------------------------------------------------------
TRENDING_HALF_LIFE_DAYS=30
TRENDING_VIEW_WEIGHT=0.35
TRENDING_LIKE_WEIGHT=2.5
TRENDING_POPULARITY_WEIGHT=1.6
TRENDING_RATING_WEIGHT=0.8
TRENDING_FRESH_DAYS=14

# Seed the demo catalogue on boot (true/false)
AUTO_SEED=true
